@baseUrl = http://localhost:3001
@rootUser = root
@rootPassword = password

# Cambia questi valori se riesegui piu volte la creazione studio.
@newStudioId = studio-http-test
@newStudioName = Studio HTTP Test
@newStudioAdminEmail = admin-http-test@studio.it
@newStudioAdminPassword = admin-http-test

@defaultStudioId = studio-marcy
@defaultAdminEmail = admin@marcy.local
@defaultAdminPassword = admin

### Health
GET {{baseUrl}}/health

### Route caricate dal processo Express
# Se questa chiamata non mostra GET /api/studios/:studioId/state, riavvia localrun.sh.
GET {{baseUrl}}/api/routes

### Root login
# @name rootLogin
POST {{baseUrl}}/api/root/login
Content-Type: application/json

{
  "username": "{{rootUser}}",
  "password": "{{rootPassword}}"
}

### Recupera studi da root
# @name rootStudiosBefore
GET {{baseUrl}}/api/root/studios
Authorization: Bearer {{rootLogin.response.body.$.token}}

### Aggiungi studio da root
# @name createStudio
POST {{baseUrl}}/api/root/studios
Authorization: Bearer {{rootLogin.response.body.$.token}}
Content-Type: application/json

{
  "id": "{{newStudioId}}",
  "name": "{{newStudioName}}",
  "adminEmail": "{{newStudioAdminEmail}}",
  "adminPassword": "{{newStudioAdminPassword}}",
  "adminName": "Admin HTTP Test",
  "timezone": "Europe/Rome",
  "calendarId": "primary",
  "validUntil": "2027-05-07",
  "yearlyPrice": 50
}

### Recupera studi dopo aggiunta
# @name rootStudiosAfterCreate
GET {{baseUrl}}/api/root/studios
Authorization: Bearer {{rootLogin.response.body.$.token}}

### Disabilita studio
# @name disableStudio
PUT {{baseUrl}}/api/root/studios/{{newStudioId}}
Authorization: Bearer {{rootLogin.response.body.$.token}}
Content-Type: application/json

{
  "enabled": false
}

### Abilita studio
# @name enableStudio
PUT {{baseUrl}}/api/root/studios/{{newStudioId}}
Authorization: Bearer {{rootLogin.response.body.$.token}}
Content-Type: application/json

{
  "enabled": true
}

### Admin login studio creato
# @name newStudioAdminLogin
POST {{baseUrl}}/api/admin/login
Content-Type: application/json

{
  "email": "{{newStudioAdminEmail}}",
  "password": "{{newStudioAdminPassword}}",
  "studioId": "{{newStudioId}}"
}

### Recupera stato studio creato
# @name getNewStudioStateBeforeSave
GET {{baseUrl}}/api/studios/{{newStudioId}}/state
Authorization: Bearer {{newStudioAdminLogin.response.body.$.token}}

### Salva stato studio creato
# @name saveNewStudioState
