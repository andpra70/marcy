### Recupera stato studio creato dopo salvataggio
# @name getNewStudioStateAfterSave
GET {{baseUrl}}/api/studios/{{newStudioId}}/state
Authorization: Bearer {{newStudioAdminLogin.response.body.$.token}}

### Admin login studio default
# @name defaultAdminLogin
POST {{baseUrl}}/api/admin/login
Content-Type: application/json

{
  "email": "{{defaultAdminEmail}}",
  "password": "{{defaultAdminPassword}}",
  "studioId": "{{defaultStudioId}}"
}

### Recupera stato studio default
# @name getDefaultStudioState
GET {{baseUrl}}/api/studios/{{defaultStudioId}}/state
Authorization: Bearer {{defaultAdminLogin.response.body.$.token}}

### Salva stato minimo studio default
# @name saveDefaultStudioState
PUT {{baseUrl}}/api/studios/{{defaultStudioId}}/state
Authorization: Bearer {{defaultAdminLogin.response.body.$.token}}
Content-Type: application/json

{
  "appModel": {
    "route": "backoffice/dashboard",
    "studio": {
      "id": "{{defaultStudioId}}",
      "name": "Studio Marcy",
      "adminEmail": "{{defaultAdminEmail}}",
      "calendarId": "primary",
      "timezone": "Europe/Rome"
    },
    "clients": [],
    "appointments": [],
    "vouchers": [],
    "services": [],
    "products": [],
    "messages": [],
    "selectedClientId": "",
    "notice": "Stato minimo salvato da test HTTP."
  }
}

### Stripe payment intent trattamento/voucher
# Richiede STRIPE_SECRET_KEY configurata sul server.
# @name createPaymentIntent
POST {{baseUrl}}/create-payment-intent
Content-Type: application/json

{
  "amount": 5000
}

### Errore atteso: crea studio duplicato
# Deve restituire 400 con: Studio o amministratore gia esistente.
# @name createDuplicateStudio
POST {{baseUrl}}/api/root/studios
Authorization: Bearer {{rootLogin.response.body.$.token}}
Content-Type: application/json

{
  "id": "{{newStudioId}}",
  "name": "{{newStudioName}}",
  "adminEmail": "{{newStudioAdminEmail}}",
  "adminPassword": "{{newStudioAdminPassword}}",
  "validUntil": "2027-05-07",
  "yearlyPrice": 50
}
